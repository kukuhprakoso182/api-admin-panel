# Application
APP_NAME=api-admin-panel
APP_ENV=development
APP_PORT=8080

# Database
# (docker compose otomatis memakai DB_HOST=mysql untuk container app)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your-db-password
DB_NAME=go_service
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=10
DB_CONN_MAX_LIFETIME=300

# CORS (pisahkan dengan koma)
CORS_ALLOW_ORIGINS=http://localhost:3000

# Seeder: password awal akun superadmin/admin.
# WAJIB di-set jika APP_ENV=production; di luar production default-nya "password123".
SEED_DEFAULT_PASSWORD=

# JWT (minimal 32 karakter, contoh generate: openssl rand -base64 48)
JWT_SECRET=
JWT_ACCESS_EXPIRES_MINUTES=60
JWT_REFRESH_EXPIRES_HOURS=168

# Logging
LOG_DIR=./logs
